# ============================================================================
# T-MoE Infrastructure Environment Variables
# ============================================================================
# Copy this file to .env and populate with your infrastructure values.
#
# After running `terraform apply`, get values with:
#   cd infra/terraform && terraform output env_configuration
#
# IMPORTANT: Never commit .env to version control!
# ============================================================================

# --- AWS Configuration ---
AWS_REGION=ca-central-1

# --- SageMaker Configuration ---
# Get from: terraform output sagemaker_execution_role_arn
SAGEMAKER_ROLE_ARN=arn:aws:iam::512466680153:role/tmoe-dev-sagemaker-execution
RAW_DATA_BUCKET=tmoe-dev-raw-data-XXXXXXX

# --- S3 Configuration ---
# Get from: terraform output raw_data_bucket_name

# --- Processing Job Configuration ---
INSTANCE_TYPE=ml.m5.xlarge
DATASET_NAME=KrisMinchev/wikitext-2-raw-v1

# --- Environment ---
ENVIRONMENT=dev
LOG_LEVEL=INFO

# --- AWS Batch Configuration ---
ECR_REPOSITORY_URL=512466680153.dkr.ecr.ca-central-1.amazonaws.com/tmoe-dev-training
BATCH_JOB_QUEUE=tmoe-dev-training
BATCH_JOB_DEFINITION=tmoe-dev-training
BATCH_LOG_GROUP=/aws/batch/tmoe-dev/training

# --- Weights & Biases Configuration ---
# Get from: https://wandb.ai/authorize
WANDB_API_KEY=XXXXX
